{
  "manifest_version": 3,
  "name": "AI CV Studio — Save this job",
  "short_name": "CV Studio",
  "version": "1.0.0",
  "description": "Save the job advert you're reading to your AI CV Studio job tracker in one click.",
  "homepage_url": "https://aicvstudio.app/jobs",
  "action": {
    "default_title": "Save this job to AI CV Studio",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "contextMenus"]
}
